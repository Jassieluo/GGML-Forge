# GGML-Forge AutoDL runtime configuration.
# Copy to /root/.config/ggml-forge/server.env and restart the service.

FORGE_HOST=127.0.0.1
FORGE_PORT=6006
FORGE_DEVICE=CUDA0
FORGE_THREADS=16
FORGE_MAX_CONCURRENCY=1

# The model path is derived as:
#   ${FORGE_LLM_MODEL_DIR}/${FORGE_LLM_MODEL_NAME}-${FORGE_LLM_QUANT}.gguf
# Set FORGE_LLM_MODEL to an absolute path to override that convention.
FORGE_LLM_MODEL_DIR=/root/autodl-tmp/models/Qwen3.6-35B-A3B
FORGE_LLM_MODEL_NAME=Qwen3.6-35B-A3B
FORGE_LLM_QUANT=Q4_K_M
FORGE_LLM_MODEL=
FORGE_LLM_CONTEXT=131072
FORGE_LLM_GPU_LAYERS=-1

FORGE_ASR_MODEL=/root/autodl-tmp/models/asr/whisper_cpp/whisper-small-q4_0.bin
FORGE_TTS_MODEL=/root/autodl-tmp/models/tts/gpt_sovits/configs/v2-q4.json

# Settings used by /root/forge-chat.
FORGE_CHAT_MAX_TOKENS=2048
FORGE_CHAT_TEMPERATURE=0.7
